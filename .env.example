PORT=8084
DATABASE_URL=postgres://quote:changeme@localhost:5432/quote-db?sslmode=disable
AUTH_SERVICE_URL=http://localhost:8080
# Owner account (auth-service user id UUID) allowed to write links; empty = writes denied
OWNER_USER_ID=
# Telegram notifications for the feedback inbox — either empty disables sending
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POSTGRES_USER=quote
POSTGRES_PASSWORD=changeme
POSTGRES_DB=quote-db
# Certificate uploads go to media-service, which owns the R2 credentials and
# the portfolio-assets bucket. This service holds no storage credential of its
# own. Uploads answer 503 while this is unset; every other endpoint keeps
# working.
MEDIA_SERVICE_URL=http://media-service:8080
